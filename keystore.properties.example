# Release signing config for the native Android app.
# Copy this file to `keystore.properties` (gitignored) and fill in your values.
# The signing key itself is `butu-release.keystore` at the repo root (also gitignored).
#
# Used by android/app/build.gradle.kts to sign release APK/AAB builds. If this file is
# absent, release builds are produced unsigned (e.g. on CI without secrets).
storePassword=your-keystore-password
keyAlias=your-key-alias
keyPassword=your-key-password

# .env.example
# Hardcode these variables to instantly bypass the Jellyfin login screen on Smart TVs.
# This is highly recommended for building standalone WebOS/Tizen bundles, so you don't have to
# type URLs and passwords using a D-Pad remote.

VITE_JELLYFIN_SERVER_URL=http://192.168.1.100:8096
VITE_JELLYFIN_USER_ID=your_jellyfin_user_id
VITE_JELLYFIN_USER_NAME=your_username
VITE_JELLYFIN_TOKEN=your_api_token

# ─── Cloud marker DB (Supabase) ───────────────────────────────────────────────
# Backs the Skip Intro / Skip Credits feature when Plex Pass markers are absent
# (free Plex, Jellyfin without IntroSkipper). See cloud/supabase/README.md.
# Leave both blank to disable cloud lookups entirely.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Same values exposed to the companion app (Vite needs the VITE_ prefix to
# surface them at import.meta.env).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
